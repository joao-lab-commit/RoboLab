    <model name="amr" canonical_link="base_link">
      <pose>0 0 0.13 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>12</mass>
          <inertia>
            <ixx>0.3</ixx>
            <iyy>0.3</iyy>
            <izz>0.4</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.45 0.35 0.18</size>
            </box>
          </geometry>
        </collision>
        <collision name="apoio_traseiro">
          <pose>-0.17 0 -0.105 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.025</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.01</mu>
                <mu2>0.01</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="apoio_dianteiro">
          <pose>0.17 0 -0.103 0 0 0</pose>
          <geometry>
