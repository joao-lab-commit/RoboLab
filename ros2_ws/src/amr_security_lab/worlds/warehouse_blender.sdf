          <geometry>
            <mesh>
              <uri>meshes/roda_direita.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <joint name="left_wheel_joint" type="revolute">
        <pose relative_to="base_link">0 0.205 -0.055 0 0 0</pose>
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz expressed_in="base_link">0 1 0</xyz>
          <limit>
            <lower>-1000</lower>
            <upper>1000</upper>
            <effort>10</effort>
            <velocity>30</velocity>
          </limit>
        </axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <pose relative_to="base_link">0 -0.205 -0.055 0 0 0</pose>
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
