              <radius>0.075</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 1.5707963267948966 0 0</pose>
          <geometry>
            <mesh>
              <uri>meshes/roda_esquerda.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.205 -0.055 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.002</ixx>
            <iyy>0.002</iyy>
            <izz>0.002</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
